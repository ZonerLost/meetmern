# Copy to .env and fill in. Never commit .env.
#
#   flutter run                --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
#
# Values are compiled in at build time via String.fromEnvironment.
# android/app/build.gradle reads MAPS_API_KEY straight out of this file for the
# manifest placeholder, since the native side can't see --dart-define.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx

# Google Maps SDK — map rendering (Android manifest + iOS)
MAPS_API_KEY=
# Google Places API (New) — venue search, geocoding (HTTP)
PLACES_API_KEY=

ANDROID_FIREBASE_API_KEY=
ANDROID_FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
IOS_FIREBASE_API_KEY=
IOS_FIREBASE_APP_ID=
IOS_FIREBASE_CLIENT_ID=
IOS_BUNDLE_ID=
